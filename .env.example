# 宿主机映射端口（容器内部固定监听 7000，无需改动）
PORT=7000

# 镜像由各自的 compose 文件固定：
#   docker-compose.yml        —— 本地源码构建，镜像名 ai-gateway:latest（无需配置）
#   vps-docker-compose.yml    —— VPS/NAS 直接拉取 camel52zhang/ai-gateway:latest
# 使用方式：
#   本地开发：   docker compose up -d --build
#   VPS / NAS：  docker compose -f vps-docker-compose.yml pull && \
#                docker compose -f vps-docker-compose.yml up -d

# 允许的跨域来源（CORS）：
#   留空      = 允许任意来源（开发/单机方便，但生产环境不推荐）
#   生产建议  = 设为你的前端域名，例如 https://gw.example.com
ALLOWED_ORIGIN=

# 首次启动时用于初始化 admin 账号的密码（强烈建议设置）。
# 未设置且数据库中尚无密码时，网关会拒绝登录（不再接受"任意密码"）。
ADMIN_PASSWORD=

# 置 1 时，本次启动会把密码重置为 ADMIN_PASSWORD（未设置则生成随机密码并
# 打印到容器日志）。重置完成后请立即删除/注释掉这一行，否则每次重启都会重置。
RESET_PASSWORD=0

# 部署在 nginx 等反向代理后面时置 1，登录限流才会按真实客户端 IP 计数；
# 否则所有请求都来自代理 IP，等于全局限流（攻击者可借此把管理员锁在门外）。
# 仅在确认前置代理会重写 X-Real-IP / X-Forwarded-For 时才开启。
TRUST_PROXY=0

# ⚠️ 危险开关：置 1 时，首次运行（库中尚无密码）接受「任意密码」登录，
# 恢复到旧的宽松行为。仅用于无法设置 ADMIN_PASSWORD 的受限场景；
# 公网可达的环境切勿开启（首次运行的任何人都能占位设密）。
ALLOW_FIRST_RUN_ANY_PASSWORD=0
